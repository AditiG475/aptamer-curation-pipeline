manifest {
    name            = 'aptamer-curation-pipeline'
    author          = 'Aditi Ghosh'
    description     = 'Aptamer sequence cleaning, DNA/RNA typing, 2D/3D structure prediction and literature annotation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.0.0'
}

params {
    input               = null
    outdir              = 'results'
    help                = false

    // input columns (CSV)
    id_column           = 'entry_id'
    seq_column          = 'sequence'
    target_column       = 'target'
    binding_text_column = 'binding_text'

    // cleaning & typing
    min_length          = 8
    max_length          = 10000
    default_type        = 'RNA'

    // secondary structure & Z-score
    temperature         = 25.0
    shuffles            = 30
    seed                = 42
    strict              = false

    // tertiary structure (RhoFold+)
    run_3d              = false
    rhofold_dir         = null
    rhofold_ckpt        = null
    rhofold_python      = 'python'
    tertiary_device     = 'cpu'
    tertiary_max_length = 200
    relax_steps         = 1000
    tertiary_cpus       = 4
    tertiary_memory     = '8 GB'

    // annotation
    skip_annotation     = false
    doi_min_similarity  = 0.85
    rules               = "${projectDir}/config/classification_rules.json"
}

process {
    cpus   = 1
    memory = '2 GB'
    errorStrategy = 'finish'

    withLabel: 'tertiary' {
        cpus          = { params.tertiary_cpus }
        memory        = { params.tertiary_memory }
        maxForks      = 2
        errorStrategy = 'ignore'   // one failed 3D model must not stop the run
    }
}

profiles {
    standard { process.executor = 'local' }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled    = true
        process.container = 'aptamer-curation-pipeline:2.0'   // build with: docker build -t aptamer-curation-pipeline:2.0 .
    }
    gpu {
        params.tertiary_device = 'cuda:0'
        process { withLabel: 'tertiary' { containerOptions = '--gpus all' } }
    }
    test {
        params.input           = "${projectDir}/data/example/aptamers_messy.fasta"
        params.skip_annotation = true
    }
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
